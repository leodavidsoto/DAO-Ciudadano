npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store

# Llaves y certificados: se ignoran por defecto para que ninguna llave privada
# llegue al repo por descuido.
*.pem

# EXCEPCIÓN — trust store de CSCA del Registro Civil (ROADMAP 5.8). Son
# certificados PÚBLICOS del PKD de la ICAO, sin material privado, y TIENEN que
# versionarse: son el ancla contra la que se validan las cédulas, así que
# forman parte del artefacto desplegado. Sin ellos, el backend arranca y
# rechaza todas las lecturas NFC, y la app móvil también.
!backend/app/certs/*.pem
!mobile/android/app/src/main/assets/csca/*.pem

# Material de trabajo del PKD de la ICAO: el LDIF completo son 13 MB y el
# explorador de master lists casi 200. Los certificados que se extraen de ahí
# sí se versionan (arriba); la materia prima se descarga cuando haga falta.
/icao/

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Artefactos ZKP (circuits/). Solo se versionan el WASM y proving key exactos
# consumidos por el cliente, junto con la verification key. Los intermedios de
# ceremonia siguen excluidos.
circuits/build/
*.ptau
*.zkey
*.r1cs
*.sym
circuits/**/*.wasm
contracts/contracts/Verifier.sol

!circuits/build/
circuits/build/*
!circuits/build/verify_identity_final.zkey
!circuits/build/verification_key.json
!circuits/build/verify_identity_js/
circuits/build/verify_identity_js/*
!circuits/build/verify_identity_js/verify_identity.wasm
!contracts/contracts/Verifier.sol

# Mobile development
android-sdk/ -e 
# Environment files
*.env
*.env.*
# ...pero SÍ versionar las plantillas de ejemplo (sin secretos)
!.env.example
!**/.env.example

# Hardhat build output (regenerable con `npx hardhat compile`)
contracts/artifacts/
contracts/cache/

# Salida de solidity-coverage (regenerable con `npx hardhat coverage`)
contracts/coverage/
contracts/coverage.json

# Direcciones de despliegues locales (`scripts/deploy-maci.js`). Son de una
# cadena efímera: commitearlas invita a apuntar a contratos que ya no existen.
contracts/deployments/

# Local Netlify folder
.netlify
