.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Artefactos ZKP (circuits/) — pesados y regenerables con circuits/compile.sh.
# Los .ptau y .zkey intermedios pueden pesar cientos de MB y no aportan nada
# al repositorio: se regeneran o se descargan de la ceremonia.
circuits/build/
*.ptau
*.zkey
*.r1cs
*.sym
# El .wasm del prover se genera al compilar; se publica como asset del build
# del frontend, no como fuente versionada.
circuits/**/*.wasm
# El verificador en Solidity lo genera snarkjs a partir del .zkey: versionarlo
# invita a que se desincronice de la llave con la que realmente se verifica.
contracts/contracts/Verifier.sol

# Mobile development
android-sdk/ -e 
# Environment files
*.env
*.env.*
# ...pero SÍ versionar las plantillas de ejemplo (sin secretos)
!.env.example
!**/.env.example

# Hardhat build output (regenerable con `npx hardhat compile`)
contracts/artifacts/
contracts/cache/

# Salida de solidity-coverage (regenerable con `npx hardhat coverage`)
contracts/coverage/
contracts/coverage.json
