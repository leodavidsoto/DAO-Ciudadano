# === DAO Ciudadana — Contracts (Hardhat) ===
# Copia este archivo a `.env`. NUNCA commitees `.env` con una llave con fondos.

# --- RPC endpoints ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Wallet de despliegue ---
# Llave privada SIN el prefijo 0x. Usa una wallet dedicada de testnet.
PRIVATE_KEY=

# --- Verificación de contratos ---
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# --- Roles del contrato (ADR 0001, decisión D-1) ---
# Separar acuñar de administrar: una llave de acuñación filtrada no debe poder
# pausar ni revocar. ADMIN debería ser un Safe multisig, nunca una EOA.
ADMIN_ADDRESS=
MINTER_ADDRESS=
