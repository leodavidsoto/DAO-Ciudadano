# === DAO Ciudadana — Contracts (Hardhat) ===
# Copia este archivo a `.env`. NUNCA commitees `.env` con una llave con fondos.

# --- RPC endpoints ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Wallet de despliegue ---
# Llave privada SIN el prefijo 0x. Usa una wallet dedicada de testnet.
PRIVATE_KEY=

# --- Membresía ZK (obligatorio fuera de localhost) ---
# Safe/multisig que administrará raíces, pausa y revocaciones.
SBT_ADMIN_ADDRESS=
# Verifier.sol desplegado desde la ceremonia independiente y auditada.
ZK_VERIFIER_ADDRESS=
# URI genérica compartida: nunca debe contener RUT ni datos personales.
SBT_METADATA_URI=ipfs://dao-ciudadana/membership-v1

# --- Verificación de contratos ---
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
