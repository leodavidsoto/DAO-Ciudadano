# === DAO Ciudadana — Frontend ===
# Copia este archivo a `.env`. Las variables deben empezar con REACT_APP_.

# URL del backend
REACT_APP_BACKEND_URL=http://localhost:8000

# Dirección EVM del emisor que firma las credenciales identity wallet-bound.
# Sin este valor el cliente ZK falla cerrado antes de generar una prueba.
REACT_APP_ZK_IDENTITY_ISSUER_ADDRESS=

# Contrato DAOCiudadanaSBT cuyo membershipScope() se consulta antes de emitir
# el commitment. Debe existir en la red conectada por la wallet.
REACT_APP_MEMBERSHIP_CONTRACT_ADDRESS=

# Opcionales: por defecto `npm run build` copia y sirve los artefactos exactos
# de circuits/build bajo /zk. Define URLs distintas solo si publicas los tres
# archivos juntos y verificas sus hashes contra artifact-manifest.json.
# REACT_APP_ZK_WASM_URL=/zk/verify_identity.wasm
# REACT_APP_ZK_ZKEY_URL=/zk/verify_identity_final.zkey
# REACT_APP_ZK_VKEY_URL=/zk/verification_key.json
