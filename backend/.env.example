# === DAO Ciudadana — Backend ===
# Copia este archivo a `.env` y completa los valores. NUNCA commitees `.env`.

# --- Entorno y modo de membresía ---
# Valores: development | test | demo | production. Si se omite, usa
# production (fail-closed). El modo demo debe declararse explícitamente.
APP_ENV=development
# Valores: disabled | demo | onchain. `demo` solo escribe en MongoDB;
# `onchain` nunca degrada silenciosamente a demo si falta configuración.
MINT_MODE=demo

# --- Base de datos ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=dao_ciudadana

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_TOKEN_EXPIRE_SECONDS=3600
# EIP-4361: el dominio/URI que la wallet muestra y firma. En producción deben
# coincidir exactamente con el frontend público y usar HTTPS.
SIWE_CHALLENGE_EXPIRE_SECONDS=300
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=11155111
# --- Sesión web en cookie (tarea 1.13) ---
# El JWT de SIWE viaja además en una cookie HttpOnly para que el frontend no
# lo guarde en localStorage. Vacío = derivado del entorno:
#   SameSite -> `none` en producción (frontend y API son sitios distintos),
#               `lax` fuera de producción.
#   Secure   -> true en producción o siempre que SameSite sea `none`.
# Un navegador DESCARTA SameSite=None sin Secure: no los combines a mano.
SESSION_COOKIE_NAME=dao_session
SESSION_COOKIE_SAMESITE=
SESSION_COOKIE_SECURE=
# Solo si frontend y API comparten dominio registrable. Vacío = cookie de host
# (lo correcto para Netlify + Render, que son dominios distintos).
SESSION_COOKIE_DOMAIN=
# Cookie legible por JS a propósito: es la mitad del doble envío CSRF y el
# cliente la repite en la cabecera X-CSRF-Token.
CSRF_COOKIE_NAME=dao_csrf
# Presupuestos por IP/minuto. Toda petición consume el global y auth, mint y
# votos consumen además el bucket sensible compartido (no uno por recurso/ID).
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_SENSITIVE_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# El rate limiter usa el peer TCP y NO confía en X-Forwarded-For por defecto.
# Solo agrega IP/CIDR de proxies que hayas verificado en tu infraestructura,
# separados por comas. Nunca uses "*" ni inventes rangos del proveedor.
TRUSTED_PROXY_IPS=

# Pepper HMAC para índices ciegos/hash de identidad. Genera un secreto largo
# distinto de SECRET_KEY y guárdalo solo en el gestor de secretos.
IDENTITY_PEPPER=
# Genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# --- CORS ---
# Lista separada por comas de orígenes permitidos. En producción NO uses "*".
# Ejemplo: https://tu-app.netlify.app,https://tudominio.cl
CORS_ORIGINS=http://localhost:3000
# Opcional: regex para orígenes dinámicos (previews de Netlify, cuyo subdominio
# cambia en cada build). Acótalo a tu dominio; nunca uses '.*'.
# Ejemplo: ^https://([a-z0-9-]+--)?tu-sitio\.netlify\.app$
CORS_ORIGIN_REGEX=

# --- Modo debug ---
# true expone /docs y /redoc y devuelve detalle de errores. Déjalo en false en producción.
DEBUG=true

# --- Gobernanza ---
# Fuente de verdad para verificar membresía en los endpoints de gobernanza.
#   mongo   -> colección `members` de MongoDB (estado actual)
#   onchain -> hasMembership() del contrato SBT (ROADMAP 3.1). Exige
#              SEPOLIA_RPC_URL y SBT_CONTRACT_ADDRESS; si el RPC no responde,
#              los endpoints devuelven 503 (nunca un 403 que insinúe que la
#              persona no es miembro).
MEMBERSHIP_SOURCE=mongo
# Caché de hasMembership() por dirección, en memoria de proceso. Corta a
# propósito: acota las llamadas al RPC sin que una revocación on-chain tarde
# en verse. 0 desactiva la caché.
MEMBERSHIP_CACHE_TTL_SECONDS=30
MEMBERSHIP_CACHE_MAX_ENTRIES=5000
# Mantener false hasta que el frontend firme y envíe todas las papeletas.
SIGNED_BALLOTS_REQUIRED=false

# --- Blockchain (solo cuando MINT_MODE=onchain) ---
# La dirección histórica 0x813f... usa la ABI Ownable/string y NO es compatible
# con el contrato AccessControl/bytes32 actual. Configura aquí solo la nueva
# dirección después de redesplegar, asignar MINTER_ROLE y verificar el código.
SBT_CONTRACT_ADDRESS=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Llave de la wallet con MINTER_ROLE. NUNCA la subas al repo. Idealmente en un KMS.
MINTER_PRIVATE_KEY=

# --- IA / Liveness de demo (opcional; no apto para producción) ---
# Un LLM generalista no sustituye un proveedor especializado de liveness.
EMERGENT_LLM_KEY=

# === Rate limiter compartido (ROADMAP 3.8) ===
# Vacio = contadores en memoria de proceso. Con varios workers eso significa
# que el limite efectivo es el configurado MULTIPLICADO por el numero de
# instancias, y que un reinicio devuelve la cuota entera a quien la agoto.
# Con REDIS_URL el limite pasa a ser global. /health/ready reporta cual esta
# activo en `rate_limit.shared_across_workers`.
REDIS_URL=

# === ERC-4337: bundler y paymaster (ADR-001, D-1) ===
# Arquitectura NO custodial: la Safe es del ciudadano y firma el con MetaMask.
# El backend solo prepara, valida y retransmite. NO configures
# SAFE_OWNER_PRIVATE_KEY: no se usa, y tenerla se reporta como error.
ERC4337_ENABLED=false
# La URL lleva la API key del proveedor. NUNCA la pongas aqui ni la commitees:
# va en `.env` (ignorado por git). Formato Pimlico:
#   https://api.pimlico.io/v2/sepolia/rpc?apikey=<TU_CLAVE>
BUNDLER_RPC_URL=
ERC4337_ENTRYPOINT_VERSION=0.7
ERC4337_ACCOUNT_IMPLEMENTATION=safe
# Modulo Safe4337 canonico. Es el verifyingContract del dominio EIP-712: con
# otra direccion el modulo rechaza toda firma.
SAFE_4337_MODULE_ADDRESS=0x75cf11467937ce3F2f357CE24ffc3DBF8fD5c226
PAYMASTER_SPONSOR_METHOD=pm_sponsorUserOperation
# Informativa para el cliente.
ERC4337_PAYMASTER_ADDRESS=

# === MACI (ADR-001, D-3) ===
# Contrato MACICoordinator desplegado. El cliente lo fija y contrasta la llave
# del coordinador contra la cadena.
MACI_COORDINATOR_ADDRESS=

# === Emisor de credenciales ZK (ADR-001, D-2) ===
# Firma la credencial EIP-191 que el cliente verifica. Distinta de
# MINTER_PRIVATE_KEY a proposito: firmar credenciales y enviar transacciones
# son poderes separados.
IDENTITY_ISSUER_PRIVATE_KEY=
IDENTITY_GRANT_TTL_SECONDS=300
# Proveedor civil real. Vacio = la emision falla cerrado en produccion.
# Los simuladores de ClaveUnica/NFC/liveness NUNCA deben emitir grants.
IDENTITY_PROVIDER=
