# === DAO Ciudadana — Backend ===
# Copia este archivo a `.env` y completa los valores. NUNCA commitees `.env`.

# --- Entorno y modo de membresía ---
# Valores: development | test | demo | production. Si se omite, usa
# production (fail-closed). El modo demo debe declararse explícitamente.
APP_ENV=development
# Valores: disabled | demo | onchain. `demo` solo escribe en MongoDB;
# `onchain` nunca degrada silenciosamente a demo si falta configuración.
MINT_MODE=demo

# --- Base de datos ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=dao_ciudadana

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_TOKEN_EXPIRE_SECONDS=3600
# EIP-4361: el dominio/URI que la wallet muestra y firma. En producción deben
# coincidir exactamente con el frontend público y usar HTTPS.
SIWE_CHALLENGE_EXPIRE_SECONDS=300
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=11155111
# --- Sesión web en cookie (tarea 1.13) ---
# El JWT de SIWE viaja además en una cookie HttpOnly para que el frontend no
# lo guarde en localStorage. Vacío = derivado del entorno:
#   SameSite -> `none` en producción (frontend y API son sitios distintos),
#               `lax` fuera de producción.
#   Secure   -> true en producción o siempre que SameSite sea `none`.
# Un navegador DESCARTA SameSite=None sin Secure: no los combines a mano.
SESSION_COOKIE_NAME=dao_session
SESSION_COOKIE_SAMESITE=
SESSION_COOKIE_SECURE=
# Solo si frontend y API comparten dominio registrable. Vacío = cookie de host
# (lo correcto para Netlify + Render, que son dominios distintos).
SESSION_COOKIE_DOMAIN=
# Cookie legible por JS a propósito: es la mitad del doble envío CSRF y el
# cliente la repite en la cabecera X-CSRF-Token.
CSRF_COOKIE_NAME=dao_csrf
# Presupuestos por IP/minuto. Toda petición consume el global y auth, mint y
# votos consumen además el bucket sensible compartido (no uno por recurso/ID).
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_SENSITIVE_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# El rate limiter usa el peer TCP y NO confía en X-Forwarded-For por defecto.
# Solo agrega IP/CIDR de proxies que hayas verificado en tu infraestructura,
# separados por comas. Nunca uses "*" ni inventes rangos del proveedor.
TRUSTED_PROXY_IPS=

# Pepper HMAC para índices ciegos/hash de identidad. Genera un secreto largo
# distinto de SECRET_KEY y guárdalo solo en el gestor de secretos.
IDENTITY_PEPPER=
# Genera con:
# python -c "from app.core.crypto import generate_key; print(generate_key())"
PII_ENCRYPTION_KEY=
# Rotación de llaves (ROADMAP 1.3): lista separada por comas, de la MÁS NUEVA a
# la más vieja. Se cifra con la primera y se descifra con cualquiera, así que
# publicar una llave nueva NO invalida lo ya guardado.
#
#   PII_ENCRYPTION_KEYS=<nueva>,<actual>
#
# Después: `python scripts/pii_maintenance.py rotate-pii --apply` y, cuando
# `status` reporte 0 pendientes, retira la vieja. Si reemplazas la llave sin
# este paso intermedio, TODA la PII existente queda ilegible.
PII_ENCRYPTION_KEYS=
# Pepper anterior mientras migras IDENTITY_PEPPER. Las búsquedas prueban con
# ambos para que nadie quede fuera de sesión; retíralo al terminar
# `reindex-lookups`. Sin esto, rotar el pepper deja a todos fuera al instante.
IDENTITY_PEPPER_PREVIOUS=

# --- Retención de datos (ROADMAP 1.4, app/core/retention.py) ---
# Días que se conserva el digest de un grant civil DESPUÉS de expirar, para
# poder investigar un canje anómalo. 0 = conservar indefinidamente.
IDENTITY_GRANT_RETENTION_DAYS=30
# Borrado de registros de ciudadanos inactivos. 0 = DESACTIVADO, y es el valor
# correcto por defecto: eliminar el registro civil de una persona es una
# decisión de gobernanza, no un TTL. Ni siquiera activado se borra solo — hay
# que ejecutar `pii_maintenance.py purge --apply`.
INACTIVE_USER_RETENTION_DAYS=0

# --- CORS ---
# Lista separada por comas de orígenes permitidos. En producción NO uses "*".
# Ejemplo: https://tu-app.netlify.app,https://tudominio.cl
CORS_ORIGINS=http://localhost:3000
# Opcional: regex para orígenes dinámicos (previews de Netlify, cuyo subdominio
# cambia en cada build). Acótalo a tu dominio; nunca uses '.*'.
# Ejemplo: ^https://([a-z0-9-]+--)?tu-sitio\.netlify\.app$
CORS_ORIGIN_REGEX=

# --- Modo debug ---
# true expone /docs y /redoc y devuelve detalle de errores. Déjalo en false en producción.
DEBUG=true

# --- Gobernanza ---
# Fuente de verdad para verificar membresía en los endpoints de gobernanza.
#   mongo   -> colección `members` de MongoDB (estado actual)
#   onchain -> hasMembership() del contrato SBT (ROADMAP 3.1). Exige
#              SEPOLIA_RPC_URL y SBT_CONTRACT_ADDRESS; si el RPC no responde,
#              los endpoints devuelven 503 (nunca un 403 que insinúe que la
#              persona no es miembro).
MEMBERSHIP_SOURCE=mongo
# Caché de hasMembership() por dirección, en memoria de proceso. Corta a
# propósito: acota las llamadas al RPC sin que una revocación on-chain tarde
# en verse. 0 desactiva la caché.
MEMBERSHIP_CACHE_TTL_SECONDS=30
MEMBERSHIP_CACHE_MAX_ENTRIES=5000
# Mantener false hasta que el frontend firme y envíe todas las papeletas.
SIGNED_BALLOTS_REQUIRED=false

# --- Blockchain (solo cuando MINT_MODE=onchain) ---
# La dirección histórica 0x813f... usa la ABI Ownable/string y NO es compatible
# con el contrato AccessControl/bytes32 actual. Configura aquí solo la nueva
# dirección después de redesplegar, asignar MINTER_ROLE y verificar el código.
SBT_CONTRACT_ADDRESS=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Llave de la wallet con MINTER_ROLE. NUNCA la subas al repo. Idealmente en un KMS.
MINTER_PRIVATE_KEY=

# === Tesorería real (ROADMAP 3.6) ===
# Dirección del Safe cuyo balance publica /api/governance/treasury. Vacía = la
# tesorería se reporta como NO configurada; nunca con números inventados.
TREASURY_SAFE_ADDRESS=
# RPC propio de la tesorería. Vacío = se reutiliza SEPOLIA_RPC_URL. Se separa
# porque el Safe puede vivir en otra red distinta a la del contrato del SBT.
TREASURY_RPC_URL=
# Tokens ERC-20 del Safe que se consultan, por dirección de contrato y
# separados por comas. Vacío = solo ETH nativo. Los decimales y el símbolo se
# LEEN de la cadena: suponer 18 decimales mostraría el saldo de USDC (que
# tiene 6) un billón de veces mal.
#
# Solo se reporta lo que se declara aquí: si el Safe tiene otro token que no
# esté en esta lista, no aparece y el total no lo incluye (`assets_covered`).
# Ejemplo (mainnet): USDC,DAI
#   TREASURY_TOKENS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48,0x6B175474E89094C44Da98b954EedeAC495271d0F
TREASURY_TOKENS=
# Tope de tokens por foto: cada uno son 3 llamadas al RPC más una a la API de
# precios, en un endpoint público.
TREASURY_MAX_TOKENS=20
# El endpoint es público y sin autenticar: la caché evita que refrescar el
# dashboard en bucle amplifique tráfico contra el RPC y la API de precios.
TREASURY_CACHE_TTL_SECONDS=60
# coingecko | binance | none. Con `none` los balances se siguen publicando en
# ETH (que es lo que se leyó de la cadena) y el valor en USD queda ausente.
#
# IMPORTANTE: fuera de mainnet el valor en USD SIEMPRE es null, aunque haya
# proveedor. El ETH de Sepolia no tiene precio de mercado y convertirlo a
# dólares sería fabricar dinero en la pantalla del ciudadano.
ETH_PRICE_PROVIDER=coingecko
# Override del endpoint (proxy propio, plan de pago, mirror). Debe devolver el
# mismo JSON que el proveedor declarado arriba.
ETH_PRICE_API_URL=
ETH_PRICE_CACHE_TTL_SECONDS=300
# Cuánto se admite servir el último precio conocido, marcado como `stale`,
# cuando el proveedor falla. Pasado ese margen el precio se reporta ausente.
ETH_PRICE_STALE_MAX_SECONDS=3600

# === Observabilidad ===
# Sentry. 1.0 envía el 100% de las transacciones: caro y ruidoso en producción.
# send_default_pii se fija a False en el código: esta API procesa RUT y email.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Métricas Prometheus en /metrics. NO llevan PII, pero describen el sistema
# entero (rutas, tráfico, latencias, errores). Con ENABLE_METRICS=true en
# producción, METRICS_TOKEN es OBLIGATORIO: sin él el endpoint responde 503 y
# /health/ready lo marca como bloqueante.
#   curl -H "Authorization: Bearer $METRICS_TOKEN" https://api.../metrics
ENABLE_METRICS=false
METRICS_TOKEN=

# --- IA / Liveness de demo (opcional; no apto para producción) ---
# Un LLM generalista no sustituye un proveedor especializado de liveness.
EMERGENT_LLM_KEY=

# === Rate limiter compartido (ROADMAP 3.8) ===
# Vacio = contadores en memoria de proceso. Con varios workers eso significa
# que el limite efectivo es el configurado MULTIPLICADO por el numero de
# instancias, y que un reinicio devuelve la cuota entera a quien la agoto.
# Con REDIS_URL el limite pasa a ser global. /health/ready reporta cual esta
# activo en `rate_limit.shared_across_workers`.
REDIS_URL=

# === ERC-4337: bundler y paymaster (ADR-001, D-1) ===
# Arquitectura NO custodial: la Safe es del ciudadano y firma el con MetaMask.
# El backend solo prepara, valida y retransmite. NO configures
# SAFE_OWNER_PRIVATE_KEY: no se usa, y tenerla se reporta como error.
ERC4337_ENABLED=false
# La URL lleva la API key del proveedor. NUNCA la pongas aqui ni la commitees:
# va en `.env` (ignorado por git). Formato Pimlico:
#   https://api.pimlico.io/v2/sepolia/rpc?apikey=<TU_CLAVE>
BUNDLER_RPC_URL=
ERC4337_ENTRYPOINT_VERSION=0.7
ERC4337_ACCOUNT_IMPLEMENTATION=safe
# Modulo Safe4337 canonico. Es el verifyingContract del dominio EIP-712: con
# otra direccion el modulo rechaza toda firma.
SAFE_4337_MODULE_ADDRESS=0x75cf11467937ce3F2f357CE24ffc3DBF8fD5c226
PAYMASTER_SPONSOR_METHOD=pm_sponsorUserOperation
# Informativa para el cliente.
ERC4337_PAYMASTER_ADDRESS=

# === MACI (ADR-001, D-3) ===
# Contrato MACICoordinator desplegado. El cliente lo fija y contrasta la llave
# del coordinador contra la cadena.
MACI_COORDINATOR_ADDRESS=

# === Emisor de credenciales ZK (ADR-001, D-2) ===
# Firma la credencial EIP-191 que el cliente verifica. Distinta de
# MINTER_PRIVATE_KEY a proposito: firmar credenciales y enviar transacciones
# son poderes separados.
IDENTITY_ISSUER_PRIVATE_KEY=
IDENTITY_GRANT_TTL_SECONDS=300
# Proveedor civil real. Vacio = la emision falla cerrado en produccion.
# Los simuladores de NFC/liveness NUNCA deben emitir grants.
IDENTITY_PROVIDER=

# === ClaveÚnica / OIDC (ROADMAP 4.1) ===
# SIN valores por defecto, tampoco los endpoints: los entrega la División de
# Gobierno Digital al habilitar el cliente. Escribir aquí una URL "de memoria"
# sería inventar la configuración de un tercero, así que se dejan vacías y el
# flujo responde 503 en TODOS los entornos hasta que se completen.
#
# No hay modo demo. El simulador anterior (POST /api/auth/clave-unica) se
# eliminó: devolvía un sujeto inventado para cualquier RUT con formato válido.
CLAVE_UNICA_CLIENT_ID=
CLAVE_UNICA_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la URI registrada ante el proveedor.
# La web registra /unete/clave-unica/callback. Nunca transportes el grant, el
# RUN ni el id_token por la URL.
CLAVE_UNICA_REDIRECT_URI=
# `iss` que debe traer el id_token.
CLAVE_UNICA_ISSUER=
CLAVE_UNICA_AUTHORIZATION_ENDPOINT=
CLAVE_UNICA_TOKEN_ENDPOINT=
# Opcional: solo hace falta si el RUN no viaja dentro del id_token.
CLAVE_UNICA_USERINFO_ENDPOINT=
# RS256 (exige JWKS) | HS256 (usa el client_secret). El algoritmo se FIJA aquí
# y jamás se toma de la cabecera del token: dejar que el token elija su propio
# algoritmo permite firmar con HMAC usando la clave pública —que es pública— y
# que la firma se dé por buena.
CLAVE_UNICA_ID_TOKEN_ALG=RS256
CLAVE_UNICA_JWKS_URI=
CLAVE_UNICA_SCOPES=openid run name
# Cookie HttpOnly que ata el canje al navegador que inició el flujo. Sin ella
# quien capture `code + state` podría usar /callback como oráculo PKCE desde
# otro cliente. En producción sale con SameSite=None y Secure; en local, Lax
# (los navegadores DESCARTAN SameSite=None sin Secure sobre http).
CLAVE_UNICA_BINDING_COOKIE_NAME=dao_cu_binding
# Vida de un intento de login (state + nonce + verificador PKCE + binding).
CLAVE_UNICA_LOGIN_TTL_SECONDS=600
