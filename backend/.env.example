# === DAO Ciudadana — Backend ===
# Copia este archivo a `.env` y completa los valores. NUNCA commitees `.env`.

# --- Base de datos ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=dao_ciudadana

# --- Identidad (ADR 0001, decisión D-2) ---
# Pepper del HMAC que deriva el identityHash. Es el secreto de MAYOR valor del
# sistema: en producción va en un KMS, nunca aquí ni en la base ni en los logs.
# Si se filtra, las identidades ya acuñadas quedan reversibles de forma
# retroactiva y permanente — lo on-chain no se puede rotar.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IDENTITY_PEPPER=

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Lista separada por comas de orígenes permitidos. En producción NO uses "*".
# Ejemplo: https://tu-app.netlify.app,https://tudominio.cl
CORS_ORIGINS=http://localhost:3000
# Opcional: regex para orígenes dinámicos (previews de Netlify, cuyo subdominio
# cambia en cada build). Acótalo a tu dominio; nunca uses '.*'.
# Ejemplo: ^https://([a-z0-9-]+--)?tu-sitio\.netlify\.app$
CORS_ORIGIN_REGEX=

# --- Modo debug ---
# true expone /docs y /redoc y devuelve detalle de errores. Déjalo en false en producción.
DEBUG=true

# --- Gobernanza ---
# Fuente de verdad para verificar membresía en los endpoints de gobernanza.
#   mongo   -> colección `members` de MongoDB (estado actual)
#   onchain -> hasMembership() del contrato SBT (Fase 1.5; aún NO implementado,
#              seleccionarlo falla explícitamente en vez de simular)
MEMBERSHIP_SOURCE=mongo

# --- Blockchain (para el minteo real on-chain — ver ROADMAP Fase 1.5) ---
SBT_CONTRACT_ADDRESS=0x813fd379F715107b2451553d97f29408d8185f0e
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Llave de la wallet con MINTER_ROLE. NUNCA la subas al repo. Idealmente en un KMS.
MINTER_PRIVATE_KEY=

# --- IA / Liveness (opcional) ---
# Sin esta clave, el análisis de liveness no puede ejecutarse en modo real.
EMERGENT_LLM_KEY=
